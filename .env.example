# ---------------------------------------------------------------------------
# TeachPilot — environment template
# Copy to .env and fill in. NEVER commit the real .env.
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM provider (Groq, free tier) --------------------------------------
# Get a free key at https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=gsk_your_key_here

# Optional fallback provider. Leave blank to run on Groq only.
OPENAI_API_KEY=

# Model used for generation (Groq model id).
LLM_MODEL=openai/gpt-oss-120b

# --- Embeddings ----------------------------------------------------------
# Runs locally via sentence-transformers. No key needed.
# Downloaded once (~90 MB) on first run.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Retrieval tuning ----------------------------------------------------
# Minimum RRF score for an answer to be attempted. Below this the system
# refuses ("not enough information") instead of guessing.
SIMILARITY_THRESHOLD=0.03

# --- Auth ----------------------------------------------------------------
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-random-48-byte-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///domain_copilot.db

# --- Seed / demo accounts (used by scripts/seed.py) ----------------------
SEED_ADMIN_EMAIL=admin@teachpilot.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_LEAD_EMAIL=lead@teachpilot.local
SEED_LEAD_PASSWORD=ChangeMe123!
SEED_INSTRUCTOR_EMAIL=instructor@teachpilot.local
SEED_INSTRUCTOR_PASSWORD=ChangeMe123!

CORS_ORIGINS=http://localhost:5173